<% layout("/layouts/boilerplate") %>

<div class="container">

  <div class="d-flex align-items-center">
  <!-- Left button -->
  <button id="scrollLeft" class="btn btn-light me-2">
    <i class="fa-solid fa-chevron-left"></i>
  </button>

  <div class="filters d-flex flex-row flex-nowrap overflow-auto py-2">
    <div class="filter" data-category="full">
    <i class="fa-solid fa-city"></i>
      <p>All</p></div>
  <div class="filter" data-category="camping">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </div>
  <div class="filter" data-category="iconic cities">
      <i class="fa-solid fa-archway"></i>
      <p>Iconic cities</p>
  </div>
  <div class="filter" data-category="farms">
    <i class="fa-solid fa-cow"></i>
      <p>Farms</p></div>
  <div class="filter" data-category="urban">
    <i class="fa-solid fa-city"></i>
    <p>Urban</p>
  </div>
  <div class="filter" data-category="mountains">
      <i class="fa-solid fa-mountain"></i>
      <p>Mountains</p>
  </div><div class="filter" data-category="beach">
    <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beach</p></div>
  <div class="filter" data-category="pools">
    <i class="fa-solid fa-water"></i>
    <p>Pools</p>
  </div>
  <div class="filter" data-category="retreat">
      <i class="fa-solid fa-mountain-city retreat"></i>
      <p>Retreats</p>
  </div>
  <div class="filter" data-category="sky view">
      <i class="fa-solid fa-meteor sky"></i>
      <p>Sky View</p>
  </div>
  <div class="filter" data-category="castles">
      <i class="fa-brands fa-fort-awesome castle"></i>
      <p>Castles</p>
  </div>
  <div class="filter" data-category="arctic">
      <i class="fa-regular fa-snowflake" arctic></i>
      <p>Arctic</p>
  </div>
  <div class="filter" data-category="lake">
      <i class="fa-solid fa-bridge-water"></i>      
      <p>Lakes</p>
  </div>
  <div class="filter" data-category="plantation">
      <i class="fa-solid fa-bridge-water"></i>
      <p>Plantations</p>
  </div>
  <div class="filter" data-category="tower">
      <i class="fa-solid fa-tower-observation"></i>
      <p>Towers</p>
  </div>

</div>
  <button id="scrollRight" class="btn btn-light ms-0 me-3">
    <i class="fa-solid fa-chevron-right"></i>
  </button>


  <div class="tax-switch">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display Taxes  </label>
</div>
  </div>
</div>
  <div class="row">
    <% if (all.length === 0 || all.length === null) { %>
    <div class="col-12 text-center mt-4">
      <p class="text-muted"><%= message %></p>
    </div>
      <% } else { %>
    <% for (let data of all) { %>
      <div class="col-lg-3 col-md-4 col-sm-6">
        <a href="/listings/<%= data._id %>" class="listing-tag">
          <div class="card cd h-100 m-3">
            <img src="<%= data.image.url %>" class="card-img-top" alt="<%= data.title %>">
            <div class="card-img-overlay">
              <b><p><%= data.title %></p></b>
              <p>₹ <%= data.price.toLocaleString('en-IN') %> / night</p>
            </div>
            <div class="card-body">
              <div class="card-text">
                <b><p><%= data.title %></p></b>
                <p>₹ <%= data.price.toLocaleString('en-IN') %> / night <i class="tax-info">  + 18% GST</i></p>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  <% } %>  
  </div>
</div>

<script src="/js/index.js">
  
</script>