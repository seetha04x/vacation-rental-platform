<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-12 offset-3">
            <h3 class="mt-3"><%=list.title%></h3>
        <div class="card col-sm-6">
        <img src="<%=list.image.url%>" class="card-image-top mb-1" style="height: 30vh;">
        <div class="card-body">
            <div class="card-text">
<p>Owned by <i><% if(list.owner) { %><%=list.owner.username%><% } else { %>Unknown<% } %></i></p></div>
   <div class="card-text">
     <p><%=list.description%></p>
    <p>$<%=list.price.toLocaleString('en-IN')%></p>
    <p><%=list.location%></p>
    <p><%=list.country%></p>
   </div>
                    
            
        </div>
    </div>    
     <div class="row">
       <%if(currUser && list.owner && (currUser.username === list.owner.username)){%>
         <div class="col-sm-2">
        <form action="/listings/<%=list.id%>/edit" method="get">
        <button class="btn mt-3 add-btn" >Edit Details</button>
    </form> 
        </div>
        <div class="col-sm-2">  
     <form action="/listings/<%=list.id%>?_method=DELETE" method="post">
        <button class="btn mt-3 btn-dark" >DELETE </button>
    </form> 
        </div> 
      <% }%>
    
        <div class="col-sm-2">
     <form action="/listings" method="get">
        <button type="submit" class="btn mt-3 mb-3 btn-dark">Back to Listings</button>
    </form>
        </div>
      </div>  
   <hr>
         <%if(currUser){%>
            <div class="col-sm-6">
            <h5>Leave a Review</h5>
            <form action="/listings/<%=list.id%>/reviews" method="post" novalidate class="needs-validation">
        
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
                        <label for="comment" class="form-label">Comment</label>
                        <textarea type="text" name="comment" placeholder="Write your review here" required class="form-control mb-2"></textarea>

                        <div class="valid-feedback">
                            Comment looks good!
                        </div>

                <button type="submit" class="btn btn-danger mt-3 mb-3">Submit Review</button>
            </form>
             </div>
             <hr>
             <%}%>
        
             <% if (list.reviews.length>0){%>
            <h5><b>Reviews</b></h5>
         <div class="col-sm-6">
            <div class="row">
                <% (list.reviews).forEach((reviews)=>{ %>
               <DIV class="border border-danger-subtle col-sm-5 m-2 p-1 rounded-2">
                <h5><%=reviews.owner.username%></h5>
                    <div class="card-text">
  <p class="starability-result" data-rating="<%=reviews.rating%>">
    Rated: <%=reviews.rating%> stars
  </p>
                <P><%=reviews.comment%></P>
                <%if(currUser && (currUser.username === reviews.owner.username)){%>
                <form action="/listings/<%=list.id%>/reviews/<%=reviews.id%>?_method=DELETE" method="post">
                    <button class="btn btn-dark p-1 m-1" style="font-size: 0.7em;">Delete</button>
                </form>
                 <%}%>
                    </div>
               </DIV>
              
            <% }) %>
            </div>
       </div>
        <% } %>
        <div class="col-sm-6">
            <h6><b>Where you'll be</b></h6>
            <div id="map"></div> 
        </div>
</div>
</DIV>


<script>
  var listingCoords = {
    geometry: <%- JSON.stringify(list.geometry && list.geometry.coordinates.length ? list.geometry : {
      type: "Point",
      coordinates: [77.0, 9.96] // fallback
    }) %>,
    location: "<%= list.location || 'Default Location' %>",
    price:" <%=list.price.toLocaleString('en-IN')%>",
  };
</script>
<script src="/js/map.js"></script>

